# Server-only configuration. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-bytes
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=
APP_URL=http://localhost:3000

# Optional read-only project integrations (server-side only)
GITHUB_TOKEN=github-token-with-read-only-repository-and-issues-access
VERCEL_TOKEN=vercel-read-only-token
