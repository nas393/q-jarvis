# Server-only configuration. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-bytes
OWNER_PASSKEY=use-a-long-random-passkey
APP_URL=http://localhost:3000

# Optional read-only portfolio integrations (server-side only)
# GitHub token: read-only access to private repositories and issues.
GITHUB_TOKEN=
# Vercel token: read-only access to project deployments in the owning team.
VERCEL_TOKEN=
